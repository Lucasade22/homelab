{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/London",
  "schedule": ["before 8am on Monday"],
  "labels": ["renovate", "dependencies"],
  "enabledManagers": [
    "flux",
    "helm-values",
    "helmv3",
    "docker-compose",
    "dockerfile"
  ],
  "flux": {
    "enabled": true,
    "managerFilePatterns": [
      "/infrastructure/.+\\.yaml$/",
      "/apps/.+\\.yaml$/",
      "/clusters/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/infrastructure/.+\\.yaml$/",
      "/apps/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
